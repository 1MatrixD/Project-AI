# Базовый URL API «Скороход» (репозиторий skorohod-api, FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8020

# Хост CDN с картинками меню (без протокола)
NEXT_PUBLIC_CDN_HOST=cdn.skorohod.local

# Город по умолчанию для витрины
NEXT_PUBLIC_DEFAULT_CITY=msk

# Включает отладочный лог SSE-стрима в консоли браузера
NEXT_PUBLIC_DEBUG_STREAM=0
