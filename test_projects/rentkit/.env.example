# Скопируйте файл в .env и заполните значения.
# Реальные ключи в репозиторий не коммитим — берём из хранилища секретов.

# --- Postgres -----------------------------------------------------------
# Схема лежит в apps/api/src/db/schema.sql, накатывается через npm run db:schema
DATABASE_URL=postgres://rentkit:change-me@localhost:5432/rentkit
# Размер пула соединений (по умолчанию 10)
PG_POOL_MAX=10

# --- HTTP ---------------------------------------------------------------
# Порт API. Веб-клиент по умолчанию ходит именно на 8030.
PORT=8030
NODE_ENV=development
# Через запятую, без пробелов
CORS_ORIGINS=http://localhost:5173

# --- Авторизация --------------------------------------------------------
# HS256, срок жизни токена — 12 часов
JWT_SECRET=change-me
JWT_ISSUER=rentkit

# --- Платёжный провайдер (холды депозита) -------------------------------
PAYMENTS_KEY=change-me
PAYMENTS_BASE_URL=https://sandbox.payments.example/v2

# --- Уведомления --------------------------------------------------------
# Пустое значение = отправка отключена, шаблоны пишутся в лог
SMTP_URL=
SMS_GATEWAY_URL=
NOTIFY_FROM=rentkit@example.com

# --- Прочее -------------------------------------------------------------
LOG_LEVEL=debug
