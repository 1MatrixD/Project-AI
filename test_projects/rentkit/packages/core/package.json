{
  "name": "@rentkit/core",
  "version": "1.4.0",
  "private": true,
  "description": "Общие бизнес-правила RentKit: тарифы, доступность, депозиты, штрафы",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  }
}
