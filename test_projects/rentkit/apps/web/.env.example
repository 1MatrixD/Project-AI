# Базовый URL API RentKit. В dev поднимается из apps/api (npm run dev -w @rentkit/api).
VITE_API_URL=http://localhost:8030

# Идентификатор пункта выдачи по умолчанию — подставляется в фильтр каталога.
VITE_DEFAULT_LOCATION_ID=loc-msk-1

# Горизонт показа занятости на карточке товара, дней.
VITE_AVAILABILITY_DAYS=14
