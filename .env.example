# --- infrastructure (docker compose) ---
POSTGRES_USER=projectai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=projectai
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://projectai:change-me@localhost:5432/projectai

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# vector search (Qdrant + local fastembed embeddings, no API costs)
QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333

# --- backend ---
API_PORT=8010
JWT_SECRET=change-me-long-random-hex
CORS_ORIGINS=http://localhost:3010
DATA_DIR=./data

# --- language ---
# Language of AI-generated content (project overviews, task briefs, tasks extracted
# from materials) and of background job messages: en | ru.
# The UI language is chosen separately in the browser (RU / EN switch in the header).
AI_LANGUAGE=en

# --- claude (Claude Code CLI must be installed and logged in) ---
CLAUDE_BIN=claude
AI_ANALYSIS_ENABLED=true
# max files per deep AI analysis run (budget)
AI_MAX_FILES_PER_RUN=40
AI_BATCH_SIZE=12
# how many claude calls run in parallel INSIDE one job
AI_CONCURRENCY=15
# model for background indexing (sonnet — faster/cheaper) and for chat (opus = Opus 5 by default)
AI_MODEL=sonnet
AI_REASONING=low
CHAT_DEFAULT_MODEL=opus
CHAT_DEFAULT_REASONING=high

# how many background jobs run at once (indexing, briefing, planner).
# Multiplied by AI_CONCURRENCY this is the ceiling of parallel claude processes
JOB_CONCURRENCY=5
# follow-up investigation of unresolved questions: twice as slow with no measured
# quality gain on the fixtures — enable only when accuracy matters more than speed
ENRICH_FOLLOWUP=false

# --- RLM depth ---
# 1 — root plus one layer of sub-agents (cheapest)
# 2 — a sub-agent may ask its own questions and spawn its own layer (default: on a
#     monorepo this is the only way to get from apps/api to packages/core)
# 0 — unlimited depth: only the hard cap and the node budget hold it back
RLM_MAX_DEPTH=2
# how many follow-up questions are taken from one branch per level
RLM_BRANCHING=2
# safety valve: total nested investigations allowed per run
RLM_MAX_NODES=8

# --- whisper (local transcription) ---
# tiny/base/small/medium/large-v3 — large-v3 is the best for Russian; ~3 GB download on first use
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
