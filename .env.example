# --- infrastructure ---
POSTGRES_USER=projectai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=projectai
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://projectai:change-me@localhost:5432/projectai

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- backend ---
API_PORT=8010
JWT_SECRET=change-me-long-random-hex
CORS_ORIGINS=http://localhost:3010
DATA_DIR=./data

# --- claude (Claude Code CLI должен быть установлен и авторизован) ---
CLAUDE_BIN=claude
AI_ANALYSIS_ENABLED=true
# максимум файлов на один прогон глубокого ИИ-анализа (бюджет)
AI_MAX_FILES_PER_RUN=40
AI_BATCH_SIZE=6
AI_CONCURRENCY=2
# модель фоновой индексации (sonnet — быстрее/дешевле) и чата (opus = Opus 5 по умолчанию)
AI_MODEL=sonnet
AI_REASONING=low
CHAT_DEFAULT_MODEL=opus
CHAT_DEFAULT_REASONING=high

# --- whisper (локальная транскрибация) ---
# tiny/base/small/medium/large-v3 — large-v3 лучший для русского, скачивается ~3ГБ при первом использовании
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
